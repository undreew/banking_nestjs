// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "mysql"
}

model User {
  id        String    @id @default(uuid()) @db.Char(36)
  email     String    @unique(map: "uk_users_email") @db.VarChar(255)
  password  String    @db.VarChar(255)
  firstName String    @map("first_name") @db.VarChar(100)
  lastName  String    @map("last_name") @db.VarChar(100)
  role      Role      @default(USER)
  enabled   Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamp(0)
  accounts  Account[]

  @@map("users")
}

model Account {
  id            String        @id @default(uuid()) @db.Char(36)
  accountNumber String        @unique(map: "uk_accounts_account_number") @map("account_number") @db.VarChar(20)
  userId        String        @map("user_id") @db.Char(36)
  user          User          @relation(fields: [userId], references: [id], map: "fk_accounts_user")
  type          AccountType   @default(SAVINGS)
  balance       Decimal       @default(0.0000) @db.Decimal(19, 4)
  status        AccountStatus @default(ACTIVE)
  version       BigInt        @default(0)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamp(0)

  sourceTransactions      Transaction[] @relation("SourceAccountTransactions")
  destinationTransactions Transaction[] @relation("DestinationAccountTransactions")

  @@map("accounts")
}

model Transaction {
  id                      String            @id @default(uuid()) @db.Char(36)
  sourceAccountId         String?           @map("source_account_id") @db.Char(36)
  sourceAccount           Account?          @relation("SourceAccountTransactions", fields: [sourceAccountId], references: [id], map: "fk_transactions_source_account")
  destinationAccountId    String?           @map("destination_account_id") @db.Char(36)
  destinationAccount      Account?          @relation("DestinationAccountTransactions", fields: [destinationAccountId], references: [id], map: "fk_transactions_destination_account")
  type                    TransactionType
  amount                  Decimal           @db.Decimal(19, 4)
  status                  TransactionStatus @default(COMPLETED)
  idempotencyKey          String?           @unique(map: "uk_transactions_idempotency_key") @map("idempotency_key") @db.VarChar(100)
  reversalOfTransactionId String?           @map("reversal_of_transaction_id") @db.Char(36)
  reversalOf              Transaction?      @relation("TransactionReversal", fields: [reversalOfTransactionId], references: [id], map: "fk_transactions_reversal_of")
  reversals               Transaction[]     @relation("TransactionReversal")
  description             String?           @db.VarChar(500)
  createdAt               DateTime          @default(now()) @map("created_at") @db.Timestamp(0)

  @@map("transactions")
}

enum TransactionStatus {
  COMPLETED
  REVERSED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER
}

enum AccountStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum AccountType {
  SAVINGS
  CHECKING
}

enum Role {
  USER
  ADMIN
}
